# ============================================================
# Smart Query Routing & Automation System - Environment Variables
# Copy this file to .env in the Backend folder:
# cp .env.example .env
# ============================================================

# Primary Relational Database (PostgreSQL / Supabase)
# Local: postgresql://postgres:password@localhost:5432/Smart_Query_Routing
# Supabase Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/Smart_Query_Routing"

# Google Gemini AI API Key (for automated query classification & smart drafting)
GEMINI_API_KEY="your-gemini-api-key-here"

# Allowed Frontend Origins (comma-separated for multiple origins)
# Example: https://aiquerysystem.vercel.app,http://127.0.0.1:5500
FRONTEND_ORIGINS="https://aiquerysystem.vercel.app,http://127.0.0.1:5500,http://localhost:5500"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Local callback: http://127.0.0.1:8000/api/auth/google/callback
# Production callback: https://your-backend.onrender.com/api/auth/google/callback
REDIRECT_URI="http://127.0.0.1:8000/api/auth/google/callback"
