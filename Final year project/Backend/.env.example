# ============================================================
# Production & Local Environment Variables Template
# Copy this file to .env and configure your secret credentials
# ============================================================

# Primary Relational Database (Supabase PostgreSQL)
# Example: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/Smart_Query_Routing"

# Google Gemini AI API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# Frontend Allowed Origin (for CORS)
# In production on Vercel: https://your-frontend.vercel.app
FRONTEND_ORIGIN="http://127.0.0.1:5500"

# Google OAuth Credentials (Optional / for Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
REDIRECT_URI="http://127.0.0.1:8000/api/auth/google/callback"
